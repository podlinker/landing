  "narrative": {
    "northStar": "La graella d'escoltes",
    "overview": "The public landing extends the app's radio-programme-guide identity into a more expressive, editorial introduction. Programme blue carries the header and opening statement; condensed display type gives the proposition its voice. The mechanism board makes the social relationship visible as a sequence of people, podcasts and episodes. This is a flat, ruled composition, not a stack of floating cards.\n\nThe page alternates a cool paper ground, a pale blue story field and a dark closing field. A compact microphone mark anchors the brand. Examples in the mechanism board are clearly fictional; its visual treatment must not imply that following a podcast means listening to or recommending every episode.",
    "keyCharacteristics": [
      "Oversized condensed headings against plain, high-contrast color fields.",
      "One ruled, three-stage network diagram instead of decorative podcast imagery.",
      "Signal lime reserved for the call to action, selected language, status dot and example episode.",
      "Square buttons and content blocks; only person avatars and the status dot are circular."
    ],
    "rules": [
      {
        "name": "The Signal Color Rule",
        "body": "Lime indicates a specific action, selection or example; it is not a general background accent.",
        "section": "colors"
      },
      {
        "name": "The Condensed Voice Rule",
        "body": "Use Barlow Condensed for prominent propositions and named example titles; keep explanatory reading in the system sans.",
        "section": "typography"
      },
      {
        "name": "The Flat Programme Rule",
        "body": "Separate ideas with rules, spacing and purposeful field changes; do not add ambient card shadows to this system.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep people, followed podcasts and newly discovered episodes legible as separate stages.",
      "**Do** preserve the app's programme blue, cool paper, ink, signal lime and Barlow Condensed identity.",
      "**Do** use flat rules and color fields to organize information, including on mobile."
    ],
    "donts": [
      "**Don't** make a podcast follow look like a listening event or recommendation.",
      "**Don't** turn fictional examples into implied real catalog art, user testimony or account activity.",
      "**Don't** replace the square editorial language with rounded floating cards or ambient shadows."
    ]
  }
}
